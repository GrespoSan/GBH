//=============================================================================

// HELPERS — LOGICA AUTO ROBUST BOUNDED

//=============================================================================

f_clamp(float value, float lo, float hi) =>

    math.max(lo, math.min(hi, value))

f_median(array<float> values) =>
    int n = array.size(values)
    float med = na
    if n > 0
        array.sort(values, order.ascending)
        int mid = int(math.floor(n * 0.5))
        med := n % 2 == 1 ? array.get(values, mid) : (array.get(values, mid - 1) + array.get(values, mid)) * 0.5
    med

// Discovery width oggettiva: mediana della variazione assoluta Close-to-Close.
// baseOffset=1 in CLOSED, quindi anche la Discovery usa esclusivamente dati T-1 e precedenti.
f_discoveryHalf(int scanLimit, int stepBars, int baseOffset) =>
    array<float> moves = array.new_float()
    int firstOffset = stepBars
    int lastOffset = scanLimit - stepBars
    if lastOffset >= firstOffset
        for i = firstOffset to lastOffset by stepBars
            float move = math.abs(close[i + baseOffset] - close[i + stepBars + baseOffset])
            if not na(move)
                array.push(moves, move)
    float medMove = array.size(moves) > 0 ? f_median(moves) : syminfo.mintick
    math.max(syminfo.mintick, nz(medMove, syminfo.mintick))

// Geometria finale AUTO ROBUST BOUNDED.
// Usa solo il primo contatto dei test indipendenti che poi reagiscono; stima robusta
// mediana + 1,4826*MAD normalizzata ATR; la fascia finale non puo superare la Discovery.
f_autoHalf(float center, float atrNow, int scanLimit, int stepBars, int validBars, float discoveryHalf, array<float> atrHistory, int baseOffset) =>
    array<float> interactionDistances = array.new_float()
    int holdSpan = validBars * stepBars
    int firstOffset = holdSpan + stepBars
    int lastOffset = scanLimit - stepBars
    int cooldownSpan = independentCooldownBars * stepBars
    int lastAcceptedOffset = na
    float discoveryTop = center + discoveryHalf
    float discoveryBottom = center - discoveryHalf

    if lastOffset >= firstOffset
        for i = firstOffset to lastOffset by stepBars
            int bi = i + baseOffset
            bool overlapsDiscovery = low[bi] <= discoveryTop and high[bi] >= discoveryBottom
            bool previousAbove = close[i + stepBars + baseOffset] > discoveryTop
            bool previousBelow = close[i + stepBars + baseOffset] < discoveryBottom
            bool independentEntry = overlapsDiscovery and (previousAbove or previousBelow)
            bool cooldownOk = na(lastAcceptedOffset) or math.abs(i - lastAcceptedOffset) >= cooldownSpan

            if independentEntry and cooldownOk
                bool isSupportTest = previousAbove
                bool entryBroken = isSupportTest ? close[bi] < discoveryBottom : close[bi] > discoveryTop
                float atrAtTest = math.max(nz(array.get(atrHistory, bi), syminfo.mintick), syminfo.mintick)
                float rawEntryDistance = isSupportTest ? math.abs(low[bi] - center) : math.abs(high[bi] - center)
                float entryDistance = math.min(rawEntryDistance, discoveryHalf)
                bool success = false
                bool failed = entryBroken

                for k = 1 to validBars
                    int idx = i - k * stepBars + baseOffset
                    if idx >= baseOffset and not success and not failed
                        if isSupportTest
                            if close[idx] < discoveryBottom
                                failed := true
                            else if high[idx] - center >= atrAtTest * minReactionAtr
                                success := true
                        else
                            if close[idx] > discoveryTop
                                failed := true
                            else if center - low[idx] >= atrAtTest * minReactionAtr
                                success := true

                if success
                    array.push(interactionDistances, entryDistance / atrAtTest)
                lastAcceptedOffset := i

    int n = array.size(interactionDistances)
    float half = discoveryHalf
    if n >= AUTO_MIN_GEOMETRY_SAMPLES
        float med = f_median(interactionDistances)
        array<float> deviations = array.new_float()
        for j = 0 to n - 1
            array.push(deviations, math.abs(array.get(interactionDistances, j) - med))
        float mad = f_median(deviations)
        float ratio = math.max(0.0, med + AUTO_MAD_SCALE * nz(mad, 0.0))
        float robustHalf = math.max(syminfo.mintick, atrNow * ratio)
        half := math.min(discoveryHalf, robustHalf)

    math.max(syminfo.mintick, math.min(discoveryHalf, half))

f_autoHalfAudit(float center, float atrNow, int scanLimit, int stepBars, int validBars, float discoveryHalf, array<float> atrHistory, int baseOffset) =>
    array<float> interactionDistances = array.new_float()
    string samples = ""
    int holdSpan = validBars * stepBars
    int firstOffset = holdSpan + stepBars
    int lastOffset = scanLimit - stepBars
    int cooldownSpan = independentCooldownBars * stepBars
    int lastAcceptedOffset = na
    float discoveryTop = center + discoveryHalf
    float discoveryBottom = center - discoveryHalf

    if lastOffset >= firstOffset
        for i = firstOffset to lastOffset by stepBars
            int bi = i + baseOffset
            bool overlapsDiscovery = low[bi] <= discoveryTop and high[bi] >= discoveryBottom
            bool previousAbove = close[i + stepBars + baseOffset] > discoveryTop
            bool previousBelow = close[i + stepBars + baseOffset] < discoveryBottom
            bool independentEntry = overlapsDiscovery and (previousAbove or previousBelow)
            bool cooldownOk = na(lastAcceptedOffset) or math.abs(i - lastAcceptedOffset) >= cooldownSpan

            if independentEntry and cooldownOk
                bool isSupportTest = previousAbove
                bool entryBroken = isSupportTest ? close[bi] < discoveryBottom : close[bi] > discoveryTop
                float atrAtTest = math.max(nz(array.get(atrHistory, bi), syminfo.mintick), syminfo.mintick)
                float rawEntryDistance = isSupportTest ? math.abs(low[bi] - center) : math.abs(high[bi] - center)
                float entryDistance = math.min(rawEntryDistance, discoveryHalf)
                bool success = false
                bool failed = entryBroken

                for k = 1 to validBars
                    int idx = i - k * stepBars + baseOffset
                    if idx >= baseOffset and not success and not failed
                        if isSupportTest
                            if close[idx] < discoveryBottom
                                failed := true
                            else if high[idx] - center >= atrAtTest * minReactionAtr
                                success := true
                        else
                            if close[idx] > discoveryTop
                                failed := true
                            else if center - low[idx] >= atrAtTest * minReactionAtr
                                success := true

                if success
                    array.push(interactionDistances, entryDistance / atrAtTest)
                    samples += str.tostring(i) + ": " + str.tostring(entryDistance / atrAtTest, "#.########") + "\n"
                lastAcceptedOffset := i

    float dbgMed = na
    float dbgMad = na
    float dbgRawHalf = na
    int n = array.size(interactionDistances)
    float half = discoveryHalf
    if n >= AUTO_MIN_GEOMETRY_SAMPLES
        float med = f_median(interactionDistances)
        array<float> deviations = array.new_float()
        for j = 0 to n - 1
            array.push(deviations, math.abs(array.get(interactionDistances, j) - med))
        float mad = f_median(deviations)
        dbgMed := med
        dbgMad := mad
        float ratio = math.max(0.0, med + AUTO_MAD_SCALE * nz(mad, 0.0))
        float robustHalf = math.max(syminfo.mintick, atrNow * ratio)
        dbgRawHalf := robustHalf
        half := math.min(discoveryHalf, robustHalf)

    [math.max(syminfo.mintick, math.min(discoveryHalf, half)), n, dbgMed, dbgMad, dbgRawHalf, samples]

f_minSpacing(float refPrice, float rng, float atrNow) =>

    spacingMode == "ATR" ? math.max(syminfo.mintick, atrNow * minSpacingAtr) : spacingMode == "Percent Price" ? math.max(syminfo.mintick, refPrice * minSpacingPricePct / 100.0) : math.max(syminfo.mintick, rng * minSpacingRangePct / 100.0)

// Valutazione compatibile AUTO ROBUST; nello screener stepBars=1 perché il motore gira direttamente sul TF screener.

f_evaluateCompatibleV(float center, float half, int scanLimit, int stepBars, int validBars, int baseOffset) =>
    float top = center + half
    float bottom = center - half
    int supportHits = 0
    int resistanceHits = 0
    int dwellBars = 0
    int nearestHitAge = na
    int holdSpan = validBars * stepBars
    int firstOffset = holdSpan + stepBars
    int lastOffset = scanLimit - stepBars

    if lastOffset >= firstOffset
        for i = firstOffset to lastOffset by stepBars
            bool overlaps = low[i + baseOffset] <= top and high[i + baseOffset] >= bottom
            if overlaps
                dwellBars += 1
                bool isSupport = close[i + baseOffset] >= center
                bool broken = false
                for k = 1 to validBars
                    int idx = i - k * stepBars + baseOffset
                    if idx >= baseOffset
                        // v0.5.5.1: wick = interazione; Close = break/accettazione oltre bordo.
                        if isSupport and close[idx] < bottom
                            broken := true
                        if not isSupport and close[idx] > top
                            broken := true
                if not broken
                    if isSupport
                        supportHits += 1
                    else
                        resistanceHits += 1
                    int age = int(math.round(i / stepBars))
                    nearestHitAge := na(nearestHitAge) ? age : math.min(nearestHitAge, age)

    int hits = supportHits + resistanceHits
    float hitScore = 1.0 - math.exp(-hits / 18.0)
    float dwellScore = 1.0 - math.exp(-dwellBars / 45.0)
    float roleMix = math.min(supportHits, resistanceHits) / math.max(1.0, float(math.max(supportHits, resistanceHits)))
    float freshnessScore = na(nearestHitAge) ? 0.0 : math.exp(-nearestHitAge / 200.0)
    float densityScore = hits / math.max(1.0, float(dwellBars))
    densityScore := math.min(1.0, densityScore)
    float strength = 100.0 * (0.50 * hitScore + 0.15 * dwellScore + 0.12 * roleMix + 0.13 * freshnessScore + 0.10 * densityScore)
    strength := f_clamp(strength, 0.0, 100.0)
    [supportHits, resistanceHits, hits, dwellBars, nz(nearestHitAge, 99999), strength]

f_evaluateIndependentV(float center, float half, int scanLimit, int stepBars, int validBars, array<float> atrHistory, int baseOffset) =>
    float top = center + half
    float bottom = center - half
    int tests = 0
    int successes = 0
    int supportSuccess = 0
    int resistanceSuccess = 0
    int breaks = 0
    int lastAcceptedOffset = na
    int holdSpan = validBars * stepBars
    int cooldownSpan = independentCooldownBars * stepBars
    int firstOffset = holdSpan + stepBars
    int lastOffset = scanLimit - stepBars

    if enableIndependentValidation and lastOffset >= firstOffset
        for i = firstOffset to lastOffset by stepBars
            bool overlaps = low[i + baseOffset] <= top and high[i + baseOffset] >= bottom
            bool previousAbove = close[i + stepBars + baseOffset] > top
            bool previousBelow = close[i + stepBars + baseOffset] < bottom
            bool independentEntry = overlaps and (previousAbove or previousBelow)
            bool cooldownOk = na(lastAcceptedOffset) or math.abs(i - lastAcceptedOffset) >= cooldownSpan

            if independentEntry and cooldownOk
                bool isSupportTest = previousAbove
                bool broken = false
                float maxAway = 0.0
                float atrAtTest = math.max(nz(array.get(atrHistory, i + baseOffset), syminfo.mintick), syminfo.mintick)
                for k = 1 to validBars
                    int idx = i - k * stepBars + baseOffset
                    if idx >= baseOffset
                        if isSupportTest
                            if close[idx] < bottom
                                broken := true
                            maxAway := math.max(maxAway, high[idx] - center)
                        else
                            if close[idx] > top
                                broken := true
                            maxAway := math.max(maxAway, center - low[idx])
                bool reactedEnough = maxAway >= atrAtTest * minReactionAtr
                bool success = not broken and reactedEnough
                tests += 1
                if success
                    successes += 1
                    if isSupportTest
                        supportSuccess += 1
                    else
                        resistanceSuccess += 1
                if broken
                    breaks += 1
                lastAcceptedOffset := i

    float reliability = tests > 0 ? 100.0 * successes / tests : na
    [tests, successes, supportSuccess, resistanceSuccess, breaks, reliability]

f_tooCloseZone(float candidate, array<Zone> zones, float spacing) =>

    bool closeToExisting = false

    int n = array.size(zones)

    if n > 0

        for i = 0 to n - 1

            Zone z = array.get(zones, i)

            if math.abs(candidate - z.center) < spacing

                closeToExisting := true

                break

    closeToExisting

f_clusterCenter(int peakIdx, array<float> centers, array<float> strengths, float rng) =>

    float peakCenter = array.get(centers, peakIdx)

    float peakStrength = array.get(strengths, peakIdx)

    float result = peakCenter

    if clusterAdjacentLevels

        float radiusPrice = rng * scanStepPct / 100.0 * clusterRadiusSteps

        float weightedSum = 0.0

        float weightTotal = 0.0

        int n = array.size(centers)

        if n > 0

            for i = 0 to n - 1

                float c = array.get(centers, i)

                float s = array.get(strengths, i)

                if math.abs(c - peakCenter) <= radiusPrice and s >= peakStrength * clusterMinStrengthRatio

                    weightedSum += c * math.max(s, 0.01)

                    weightTotal += math.max(s, 0.01)

        if weightTotal > 0

            result := weightedSum / weightTotal

    result

// Uniche due dipendenze rese esplicite per request.security: rangeLowNow e atrSeries.

f_buildZoneV(float center, float rangeLowNow, float rng, float atrNow, int scanLimit, int stepBars, int validBars, float discoveryHalf, array<float> atrHistory, int baseOffset) =>
    float half = f_autoHalf(center, atrNow, scanLimit, stepBars, validBars, discoveryHalf, atrHistory, baseOffset)
    [supHits, resHits, hits, dwell, lastAge, strength] = f_evaluateCompatibleV(center, half, scanLimit, stepBars, validBars, baseOffset)
    [indTests, indSuccesses, indSup, indRes, indBreaks, reliability] = f_evaluateIndependentV(center, half, scanLimit, stepBars, validBars, atrHistory, baseOffset)
    float pct = rng > 0 ? 100.0 * (center - rangeLowNow) / rng : 0.0
    Zone.new(center, half, pct, strength, hits, supHits, resHits, dwell, lastAge, indTests, indSuccesses, indSup, indRes, indBreaks, reliability)

f_reactionCoveredByStructural(Zone rz, array<Zone> structuralZones) =>

    bool covered = false

    if array.size(structuralZones) > 0

        float rTop = rz.center + rz.half

        float rBottom = rz.center - rz.half

        for i = 0 to array.size(structuralZones) - 1

            Zone az = array.get(structuralZones, i)

            float aTop = az.center + az.half

            float aBottom = az.center - az.half

            if rTop >= aBottom and rBottom <= aTop

                covered := true

                break

    covered

f_distZoneAtr(float px, Zone z, float atrNow) =>

    float d = na

    if atrNow > 0

        float bottom = z.center - z.half

        float top = z.center + z.half

        d := px >= bottom and px <= top ? 0.0 : px > top ? (px - top) / atrNow : (bottom - px) / atrNow

    d

// Profilo dei tocchi recenti sulla Balance.

// LOW = test dall'alto: il close precedente era sopra la zona e il Low entra nella Balance.

// HIGH = test dal basso: il close precedente era sotto la zona e l'High entra nella Balance.

// ULTIMO: LOW/HIGH/IN/X. X = attraversamento con close oltre il lato opposto.

// PROFILO: descrizione del comportamento recente sulla Balance; solo informativa, non entra nello Score.

f_recentTouchProfile(float bottom, float top, int baseOffset) =>

    int touches = 0

    int lowTouches = 0

    int highTouches = 0

    int lastTouchType = 0

    bool latestTouchSet = false

    for k = 0 to interactionWindow - 1

        int idx = k + baseOffset

        bool touchesZone = low[idx] <= top and high[idx] >= bottom

        if touchesZone

            touches += 1

            bool previousAbove = close[idx + 1] > top

            bool previousBelow = close[idx + 1] < bottom

            int touchType = 3

            if previousAbove

                lowTouches += 1

                touchType := close[idx] < bottom ? 4 : 1

            else if previousBelow

                highTouches += 1

                touchType := close[idx] > top ? 4 : 2

            else

                touchType := 3

            if not latestTouchSet

                lastTouchType := touchType

                latestTouchSet := true

    [touches, lowTouches, highTouches, lastTouchType]

//=============================================================================


//=============================================================================
// HULL MA — formula originale dello screener Trend ITA 1
//=============================================================================

f_bridgeHma(srcH, lengthH) =>
    n2ma = 2 * ta.wma(srcH, math.round(lengthH / 2))
    nma = ta.wma(srcH, lengthH)
    diff = n2ma - nma
    sqn = math.round(math.sqrt(lengthH))
    ta.wma(diff, sqn)

// MOTORE PER SINGOLO SIMBOLO

// Structural A e Reaction B riproducono il blocco di selezione AUTO ROBUST BOUNDED.

// Il layer tocchi viene applicato DOPO la costruzione delle zone.

//=============================================================================

f_balanceActiveEngine() =>

    var array<Zone> snapZonesA = array.new<Zone>()

    var array<Zone> snapZonesB = array.new<Zone>()

    var int lastCalculationBarA = na

    var int lastCalculationBarB = na

    // Dentro request.security il contesto è già il TF screener: ratio Target/Chart = 1.

    // CLOSED sposta l'intero motore di una barra: range, ATR, tocchi, prezzo e stato sono tutti T-1.

    int targetStepChartBars = 1

    int dataOffset = dataMode == "CLOSED" ? 1 : 0


    //-------------------------------------------------------------------------
    // HULL — stessa logica del relativo screener
    //-------------------------------------------------------------------------
    float bridgeHull = f_bridgeHma(close, hullLength)
    bool bridgeBull = bridgeHull > bridgeHull[1]
    bool bridgeLongEvent = bridgeBull and not bridgeBull[1]
    bool bridgeShortEvent = not bridgeBull and bridgeBull[1]
    int bridgeBarsFromLong = ta.barssince(bridgeLongEvent)
    int bridgeBarsFromShort = ta.barssince(bridgeShortEvent)
    bool bridgeLongActive = bridgeBarsFromLong >= 0 and bridgeBarsFromLong < hullMemoryBars and bridgeBarsFromLong < bridgeBarsFromShort
    bool bridgeShortActive = bridgeBarsFromShort >= 0 and bridgeBarsFromShort < hullMemoryBars and bridgeBarsFromShort < bridgeBarsFromLong
    int bridgeHullSignalLive = bridgeLongActive ? 1 : bridgeShortActive ? -1 : 0
    int bridgeHullTrendLive = bridgeBull ? 1 : -1
    bool bridgeHullTrendChange = bridgeBull != bridgeBull[1]
    int bridgeHullMemLive = ta.barssince(bridgeHullTrendChange)
    int bridgeHullSignal = dataMode == "CLOSED" ? bridgeHullSignalLive[1] : bridgeHullSignalLive
    int bridgeHullTrend = dataMode == "CLOSED" ? bridgeHullTrendLive[1] : bridgeHullTrendLive
    int bridgeHullMem = dataMode == "CLOSED" ? bridgeHullMemLive[1] : bridgeHullMemLive

    //-------------------------------------------------------------------------
    // HEIKIN ASHI — stessa logica dello screener HA, PMO escluso
    // T-1 resta sempre l'ultima candela HA completamente chiusa.
    //-------------------------------------------------------------------------
    float bridgeHaClose = (open + high + low + close) / 4.0
    var float bridgeHaOpen = na
    bridgeHaOpen := na(bridgeHaOpen[1]) ? (open + close) / 2.0 : (bridgeHaOpen[1] + bridgeHaClose[1]) / 2.0
    float bridgeHaHigh = math.max(high, math.max(bridgeHaOpen, bridgeHaClose))
    float bridgeHaLow = math.min(low, math.min(bridgeHaOpen, bridgeHaClose))
    bool bridgeG1 = bridgeHaClose[1] >= bridgeHaOpen[1]
    bool bridgeG2 = bridgeHaClose[2] >= bridgeHaOpen[2]
    bool bridgeHaBullStrong = bridgeG1 and math.abs(bridgeHaLow[1] - bridgeHaOpen[1]) <= syminfo.mintick
    bool bridgeHaBearStrong = not bridgeG1 and math.abs(bridgeHaHigh[1] - bridgeHaOpen[1]) <= syminfo.mintick
    bool bridgeHaInversion = bridgeG1 != bridgeG2
    int bridgeHaSeq = nz(ta.barssince(bridgeG1 != bridgeG2), 0) + 1
    int bridgeHaT1 = bridgeG1 ? 1 : -1
    int bridgeHaInv = bridgeHaInversion ? (bridgeG1 ? 1 : -1) : 0
    int bridgeHaStrong = (bridgeHaBullStrong or bridgeHaBearStrong) ? (bridgeG1 ? 1 : -1) : 0

    series float atrSeries = ta.atr(atrLength)

    float atrNow = math.max(nz(atrSeries[dataOffset], syminfo.mintick), syminfo.mintick)

    //-------------------------------------------------------------------------
    // SLOPE + RET12 — SOLO INFORMATIVI, NON MODIFICANO FASE O SELEZIONE
    // SLOPE: variazione HMA della barra di riferimento, normalizzata per ATR.
    // RET12: movimento delle 12 barre precedenti, normalizzato per ATR.
    // In CLOSED (dataOffset=1): SLOPE=(HMA[1]-HMA[2])/ATR[1],
    // RET12=(Close[2]-Close[14])/ATR[1], stessa convenzione del Forward Monitor.
    //-------------------------------------------------------------------------
    float bridgeHullSlopeAtr = (bridgeHull[dataOffset] - bridgeHull[dataOffset + 1]) / atrNow
    float bridgeRet12Atr = (close[dataOffset + 1] - close[dataOffset + 13]) / atrNow

    int targetBarsInWindow = lookbackTargetBars

    float rangeHigh = ta.highest(high[dataOffset], targetBarsInWindow)

    float rangeLow = ta.lowest(low[dataOffset], targetBarsInWindow)

    int requestedChartBars = targetBarsInWindow

    int availableBars = math.max(0, bar_index - dataOffset)

    int scanChartBars = math.max(10, math.min(4800, math.min(requestedChartBars, availableBars)))

    float activeRange = math.max(rangeHigh - rangeLow, syminfo.mintick * 10)

    // ATR values are read in the continuously executed engine context.
    // Arrays preserve the explicit bar offsets across sparse nested calls.
    array<float> atrHistory = array.new_float(scanChartBars + dataOffset + 1, na)
    if barstate.islast
        for auditOffset = 0 to scanChartBars + dataOffset
            array.set(atrHistory, auditOffset, atrSeries[auditOffset])

    bool calculationDueA = na(lastCalculationBarA) or bar_index - lastCalculationBarA >= updateFrequencyBars

    bool calculationDueB = na(lastCalculationBarB) or bar_index - lastCalculationBarB >= updateFrequencyBars

    //-------------------------------------------------------------------------

    // MOTORE A - STRUCTURAL — selezione AUTO ROBUST BOUNDED

    //-------------------------------------------------------------------------

    if barstate.islast and calculationDueA and not na(rangeHigh) and not na(rangeLow) and activeRange > 0 and scanChartBars > validationBars * targetStepChartBars + targetStepChartBars * 2

        array<float> candCenterA = array.new_float()

        array<float> candStrengthA = array.new_float()

        array<int> candHitsA = array.new_int()

        float atrNowA = math.max(nz(atrSeries[dataOffset], syminfo.mintick), syminfo.mintick)

        float discoveryHalfA = f_discoveryHalf(scanChartBars, targetStepChartBars, dataOffset)

        for pct = 0.0 to 100.0 by scanStepPct

            float center = rangeLow + activeRange * pct / 100.0

            float half = discoveryHalfA

            [supHits, resHits, hits, dwell, lastAge, strength] = f_evaluateCompatibleV(center, half, scanChartBars, targetStepChartBars, validationBars, dataOffset)

            if hits >= minCompatibleHits and strength >= minStrength

                array.push(candCenterA, center)

                array.push(candStrengthA, strength)

                array.push(candHitsA, hits)

        array<Zone> newZonesA = array.new<Zone>()

        array<bool> usedA = array.new_bool(array.size(candCenterA), false)

        float spacingA = f_minSpacing(close[dataOffset], activeRange, atrNowA)

        float retentionToleranceA = activeRange * scanStepPct / 100.0 * retentionToleranceSteps

        if retainPreviousZones and array.size(snapZonesA) > 0 and array.size(candCenterA) > 0

            for old = 0 to array.size(snapZonesA) - 1

                if array.size(newZonesA) < maxDisplayedZones

                    Zone oldZone = array.get(snapZonesA, old)

                    int bestIdx = -1

                    float bestDist = 1e20

                    for c = 0 to array.size(candCenterA) - 1

                        if not array.get(usedA, c)

                            float d = math.abs(array.get(candCenterA, c) - oldZone.center)

                            if d < bestDist

                                bestDist := d

                                bestIdx := c

                    if bestIdx >= 0 and bestDist <= retentionToleranceA and array.get(candStrengthA, bestIdx) >= retentionStrength

                        float selectedCenter = f_clusterCenter(bestIdx, candCenterA, candStrengthA, activeRange)

                        if not f_tooCloseZone(selectedCenter, newZonesA, spacingA)

                            Zone z = f_buildZoneV(selectedCenter, rangeLow, activeRange, atrNowA, scanChartBars, targetStepChartBars, validationBars, discoveryHalfA, atrHistory, dataOffset)

                            array.push(newZonesA, z)

                            array.set(usedA, bestIdx, true)

        array<int> sortedA = array.sort_indices(candStrengthA, order.descending)

        if array.size(sortedA) > 0

            for n = 0 to array.size(sortedA) - 1

                if array.size(newZonesA) >= maxDisplayedZones

                    break

                int idx = array.get(sortedA, n)

                if not array.get(usedA, idx)

                    float selectedCenter = f_clusterCenter(idx, candCenterA, candStrengthA, activeRange)

                    if not f_tooCloseZone(selectedCenter, newZonesA, spacingA)

                        Zone z = f_buildZoneV(selectedCenter, rangeLow, activeRange, atrNowA, scanChartBars, targetStepChartBars, validationBars, discoveryHalfA, atrHistory, dataOffset)

                        array.push(newZonesA, z)

                        array.set(usedA, idx, true)

        int newCountA = array.size(newZonesA)

        if newCountA > 1

            for i = 0 to newCountA - 2

                for j = i + 1 to newCountA - 1

                    Zone zi = array.get(newZonesA, i)

                    Zone zj = array.get(newZonesA, j)

                    if zi.center > zj.center

                        array.set(newZonesA, i, zj)

                        array.set(newZonesA, j, zi)

        array.clear(snapZonesA)

        if array.size(newZonesA) > 0

            for i = 0 to array.size(newZonesA) - 1

                array.push(snapZonesA, array.get(newZonesA, i))

        lastCalculationBarA := bar_index

    //-------------------------------------------------------------------------

    // MOTORE B - REACTION — selezione AUTO ROBUST BOUNDED, indipendente da A

    //-------------------------------------------------------------------------

    if barstate.islast and calculationDueB and not na(rangeHigh) and not na(rangeLow) and activeRange > 0 and scanChartBars > reactionValidationBars * targetStepChartBars + targetStepChartBars * 2

        array<float> candCenterB = array.new_float()

        array<float> candStrengthB = array.new_float()

        array<int> candHitsB = array.new_int()

        float atrNowB = math.max(nz(atrSeries[dataOffset], syminfo.mintick), syminfo.mintick)

        float discoveryHalfB = f_discoveryHalf(scanChartBars, targetStepChartBars, dataOffset)

        for pct = 0.0 to 100.0 by scanStepPct

            float center = rangeLow + activeRange * pct / 100.0

            float half = discoveryHalfB

            [supHits, resHits, hits, dwell, lastAge, strength] = f_evaluateCompatibleV(center, half, scanChartBars, targetStepChartBars, reactionValidationBars, dataOffset)

            if hits >= minCompatibleHits and strength >= minStrength

                array.push(candCenterB, center)

                array.push(candStrengthB, strength)

                array.push(candHitsB, hits)

        array<Zone> newZonesB = array.new<Zone>()

        array<bool> usedB = array.new_bool(array.size(candCenterB), false)

        float spacingB = f_minSpacing(close[dataOffset], activeRange, atrNowB)

        float retentionToleranceB = activeRange * scanStepPct / 100.0 * retentionToleranceSteps

        if retainPreviousZones and array.size(snapZonesB) > 0 and array.size(candCenterB) > 0

            for old = 0 to array.size(snapZonesB) - 1

                if array.size(newZonesB) < maxDisplayedZones

                    Zone oldZone = array.get(snapZonesB, old)

                    int bestIdx = -1

                    float bestDist = 1e20

                    for c = 0 to array.size(candCenterB) - 1

                        if not array.get(usedB, c)

                            float d = math.abs(array.get(candCenterB, c) - oldZone.center)

                            if d < bestDist

                                bestDist := d

                                bestIdx := c

                    if bestIdx >= 0 and bestDist <= retentionToleranceB and array.get(candStrengthB, bestIdx) >= retentionStrength

                        float selectedCenter = f_clusterCenter(bestIdx, candCenterB, candStrengthB, activeRange)

                        if not f_tooCloseZone(selectedCenter, newZonesB, spacingB)

                            Zone z = f_buildZoneV(selectedCenter, rangeLow, activeRange, atrNowB, scanChartBars, targetStepChartBars, reactionValidationBars, discoveryHalfB, atrHistory, dataOffset)

                            array.push(newZonesB, z)

                            array.set(usedB, bestIdx, true)

        array<int> sortedB = array.sort_indices(candStrengthB, order.descending)

        if array.size(sortedB) > 0

            for n = 0 to array.size(sortedB) - 1

                if array.size(newZonesB) >= maxDisplayedZones

                    break

                int idx = array.get(sortedB, n)

                if not array.get(usedB, idx)

                    float selectedCenter = f_clusterCenter(idx, candCenterB, candStrengthB, activeRange)

                    if not f_tooCloseZone(selectedCenter, newZonesB, spacingB)

                        Zone z = f_buildZoneV(selectedCenter, rangeLow, activeRange, atrNowB, scanChartBars, targetStepChartBars, reactionValidationBars, discoveryHalfB, atrHistory, dataOffset)

                        array.push(newZonesB, z)

                        array.set(usedB, idx, true)

        int newCountB = array.size(newZonesB)

        if newCountB > 1

            for i = 0 to newCountB - 2

                for j = i + 1 to newCountB - 1

                    Zone zi = array.get(newZonesB, i)

                    Zone zj = array.get(newZonesB, j)

                    if zi.center > zj.center

                        array.set(newZonesB, i, zj)

                        array.set(newZonesB, j, zi)

        array.clear(snapZonesB)

        if array.size(newZonesB) > 0

            for i = 0 to array.size(newZonesB) - 1

                array.push(snapZonesB, array.get(newZonesB, i))

        lastCalculationBarB := bar_index

    //-------------------------------------------------------------------------

    // LAYER SCREENER — non modifica le zone selezionate dal motore

    //-------------------------------------------------------------------------

    float bestCenter = na

    float bestHalf = na

    float bestStrength = na

    float bestReliability = na

    int bestHits = 0

    int bestTests = 0

    int bestTouches = 0

    int bestLowTouches = 0

    int bestHighTouches = 0

    int bestLastTouchType = 0

    int bestEngine = 0

    float bestDist = na

    float bestScore = -1.0

    int nA = array.size(snapZonesA)

    if barstate.islast and nA > 0

        for zIdx = 0 to nA - 1

            Zone z = array.get(snapZonesA, zIdx)

            float bottom = z.center - z.half

            float top = z.center + z.half

            [touches, lowTouches, highTouches, lastTouchType] = f_recentTouchProfile(bottom, top, dataOffset)

            bool priceInside = close[dataOffset] >= bottom and close[dataOffset] <= top

            bool eligible = touches >= minInteractionBars and (not requireLastInside or priceInside)

            if eligible

                float distAtr = f_distZoneAtr(close[dataOffset], z, atrNow)

                float touchScore = 100.0 * float(touches) / float(interactionWindow)

                float relScore = na(z.reliability) ? 50.0 : z.reliability

                float score = f_clamp(0.45 * touchScore + 0.35 * z.strength + 0.20 * relScore, 0.0, 100.0)

                if score > bestScore

                    bestScore := score

                    bestCenter := z.center

                    bestHalf := z.half

                    bestStrength := z.strength

                    bestReliability := z.reliability

                    bestHits := z.hits

                    bestTests := z.independentTests

                    bestTouches := touches

                    bestLowTouches := lowTouches

                    bestHighTouches := highTouches

                    bestLastTouchType := lastTouchType

                    bestEngine := ENGINE_STRUCTURAL

                    bestDist := distAtr

    int nB = array.size(snapZonesB)

    if barstate.islast and engineMode == "A+B" and nB > 0

        for zIdx = 0 to nB - 1

            Zone z = array.get(snapZonesB, zIdx)

            if not f_reactionCoveredByStructural(z, snapZonesA)

                float bottom = z.center - z.half

                float top = z.center + z.half

                [touches, lowTouches, highTouches, lastTouchType] = f_recentTouchProfile(bottom, top, dataOffset)

                bool priceInside = close[dataOffset] >= bottom and close[dataOffset] <= top

                bool eligible = touches >= minInteractionBars and (not requireLastInside or priceInside)

                if eligible

                    float distAtr = f_distZoneAtr(close[dataOffset], z, atrNow)

                    float touchScore = 100.0 * float(touches) / float(interactionWindow)

                    float relScore = na(z.reliability) ? 50.0 : z.reliability

                    float score = f_clamp(0.45 * touchScore + 0.35 * z.strength + 0.20 * relScore, 0.0, 100.0)

                    if score > bestScore

                        bestScore := score

                        bestCenter := z.center

                        bestHalf := z.half

                        bestStrength := z.strength

                        bestReliability := z.reliability

                        bestHits := z.hits

                        bestTests := z.independentTests

                        bestTouches := touches

                        bestLowTouches := lowTouches

                        bestHighTouches := highTouches

                        bestLastTouchType := lastTouchType

                        bestEngine := ENGINE_REACTION

                        bestDist := distAtr

    [dbgHalf, dbgCount, dbgMed, dbgMad, dbgRawHalf, dbgSamples] = f_autoHalfAudit(bestCenter, atrNow, scanChartBars, targetStepChartBars, bestEngine == ENGINE_STRUCTURAL ? validationBars : reactionValidationBars, f_discoveryHalf(scanChartBars, targetStepChartBars, dataOffset), atrHistory, dataOffset)

    [close[dataOffset], bestCenter, bestHalf, bestStrength, bestReliability, bestHits, bestTests, bestTouches, bestLowTouches, bestHighTouches, bestLastTouchType, bestEngine, bestDist, math.max(0.0, bestScore), bridgeHullSignal, bridgeHullTrend, bridgeHullMem, bridgeHaT1, bridgeHaInv, bridgeHaStrong, bridgeHaSeq, bridgeHullSlopeAtr, bridgeRet12Atr, time_close[dataOffset], atrNow, f_discoveryHalf(scanChartBars, targetStepChartBars, dataOffset), rangeLow, rangeHigh, high[dataOffset + 2], dbgCount, dbgMed, dbgMad, dbgRawHalf, dbgSamples]

//=============================================================================

// TICKER HELPER

//=============================================================================

f_ticker(string sym) =>

    parts = str.split(sym, ":")

    array.size(parts) > 1 ? array.get(parts, 1) : sym

//=============================================================================
// CLASSIFICAZIONE RADAR — derivata, non modifica i segnali originali
// SETUP descrive la Balance; FASE descrive il timing Hull/HA.
// La distanza ATR NON cancella più EARLY/FRESH/TRANSITION/MATURE.
// Δ resta informativo e NON entra nella classificazione.
//=============================================================================

f_balanceProfile(int lowTouches, int highTouches, int lastTouchType) =>
    lastTouchType == 4 ? "CROSS" : lowTouches > highTouches ? "SUPPORT TEST" : highTouches > lowTouches ? "RESISTANCE TEST" : lastTouchType == 3 ? "INSIDE" : lowTouches > 0 ? "MIXED" : "INSIDE"

f_setup(int lowTouches, int highTouches, int lastTouchType) =>
    string profile = f_balanceProfile(lowTouches, highTouches, lastTouchType)
    profile == "SUPPORT TEST" ? "A" : "B"

f_phase(int hullSignal, int hullTrend, int hullMem, int haT1, int haInv, int haSeq) =>
    bool bullContext = hullTrend == 1 and haT1 == 1
    bool freshHull = bullContext and hullSignal == 1 and not na(hullMem) and hullMem >= 0 and hullMem < hullMemoryBars
    bool earlyHa = bullContext and haInv == 1 and haSeq == 1 and not freshHull
    bool transition = haT1 == 1 and not na(haSeq) and haSeq >= 1 and haSeq <= 2 and hullTrend == -1
    freshHull ? "FRESH" : earlyHa ? "EARLY" : transition ? "TRANSITION" : bullContext ? "MATURE" : "WAIT"

f_setupColor(string setup, color fallback) =>
    setup == "A" ? color.rgb(200,230,201) : setup == "B" ? color.rgb(255,243,205) : fallback

f_phaseColor(string phase, color fallback) =>
    phase == "FRESH" ? color.rgb(76,175,80) :
     phase == "EARLY" ? color.rgb(129,199,132) :
     phase == "TRANSITION" ? color.rgb(128,203,196) :
     phase == "MATURE" ? color.rgb(224,224,224) : fallback

// Valore usato SOLO per ordinare la tabella in modalità Priorità RADAR.
// Non è uno score di qualità e non entra nei segnali.
f_priority(string setup, string phase, float distAtr, int touches) =>
    // Ordine operativo, non score di qualità. La distanza ha abbastanza peso da far
    // salire AREA ATTIVA / casi molto vicini rispetto a fasi nominalmente superiori ma lontane.
    float base = setup == "A" and phase == "EARLY" ? 900.0 :
                 setup == "A" and phase == "TRANSITION" ? 880.0 :
                 setup == "A" and phase == "FRESH" ? 860.0 :
                 setup == "B" and phase == "EARLY" ? 840.0 :
                 setup == "B" and phase == "FRESH" ? 820.0 :
                 setup == "B" and phase == "TRANSITION" ? 800.0 :
                 setup == "A" and phase == "MATURE" ? 700.0 :
                 setup == "B" and phase == "MATURE" ? 660.0 :
                 setup == "A" ? 420.0 : 400.0
    float proximityBonus = na(distAtr) ? 0.0 : distAtr == 0.0 ? 120.0 : math.max(0.0, 100.0 - math.min(distAtr, 2.0) * 50.0)
    float touchBonus = math.min(float(touches), 9.0) * 0.1
    base + proximityBonus + touchBonus

//=============================================================================


// Solo diagnostica: stessa funzione motore V12, nessun alert.
string auditSymbol = input.symbol("MIL_LS:PRY", "Simbolo audit", group="Audit")
[p, center, half, strength, rel, hits, tests, touches, lowTouches, highTouches, lastTouchType, engineType, distAtr, score, hullSignal, hullTrend, hullMem, haT1, haInv, haStrong, haSeq, hullSlopeAtr, ret12Atr, srcTs, auditAtr, discovery, rangeLo, rangeHi, thirdHigh, dbgCount, dbgMed, dbgMad, dbgRawHalf, dbgSamples] = request.security(auditSymbol, screenerTf, f_balanceActiveEngine(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on, ignore_invalid_symbol=true, calc_bars_count=lookbackTargetBars + 120)
var table auditTable = table.new(position.top_right, 2, 23, border_width=1)
if barstate.islast
    array<string> keys = array.from("SIMBOLO / SORGENTE", "PREZZO", "BALANCE", "HALF", "BORDO INFERIORE", "BORDO SUPERIORE", "ATR", "DISCOVERY HALF", "MOTORE", "TOCCHI / LOW / HIGH", "FASE", "HULL / MEM", "HA / SEQ", "SLOPE / RET12", "RANGE LOW", "RANGE HIGH", "HIGH TERZA CANDELA", "STRENGTH / REL", "CAMPIONI GEOMETRIA", "MEDIANA", "MAD", "HALF ROBUSTA PRE-LIMITE", "OFFSET / DISTANZA ATR")
    string srcText = na(srcTs) ? "NA" : str.format_time(srcTs, "yyyy-MM-dd HH:mm", "Europe/Rome")
    array<string> vals = array.from(auditSymbol + " / " + srcText, str.tostring(p, "#.########"), str.tostring(center, "#.########"), str.tostring(half, "#.########"), str.tostring(center-half, "#.########"), str.tostring(center+half, "#.########"), str.tostring(auditAtr, "#.########"), str.tostring(discovery, "#.########"), engineType == 1 ? "A" : engineType == 2 ? "B" : "—", str.tostring(touches) + " / " + str.tostring(lowTouches) + " / " + str.tostring(highTouches), f_phase(hullSignal, hullTrend, hullMem, haT1, haInv, haSeq), str.tostring(hullSignal) + " / " + str.tostring(hullTrend) + " / " + str.tostring(hullMem), str.tostring(haT1) + " / " + str.tostring(haSeq), str.tostring(hullSlopeAtr, "#.########") + " / " + str.tostring(ret12Atr, "#.########"), str.tostring(rangeLo, "#.########"), str.tostring(rangeHi, "#.########"), str.tostring(thirdHigh, "#.########"), str.tostring(strength, "#.########") + " / " + str.tostring(rel, "#.########"), str.tostring(dbgCount), str.tostring(dbgMed, "#.########"), str.tostring(dbgMad, "#.########"), str.tostring(dbgRawHalf, "#.########"), dbgSamples)
    for i = 0 to 22
        table.cell(auditTable, 0, i, array.get(keys, i), text_color=color.white, bgcolor=color.rgb(50,50,50), text_size=size.small)
        table.cell(auditTable, 1, i, array.get(vals, i), text_color=color.white, bgcolor=color.rgb(25,25,25), text_size=size.small)
